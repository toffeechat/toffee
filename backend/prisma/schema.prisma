// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // 검색 속도용 pg_trgm 확장을 스키마에 적어 두려고(2026-09-29)
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // pg_trgm: 글자 조각(3글자) 색인 — "중간에 이 글자가 들어간 것" 검색(ILIKE '%…%')을 빠르게. Postgres 기본 포함 확장
  extensions = [pg_trgm]
}

// 운영자 권한 단계(2026-10-20)
enum AdminLevel {
  OWNER
  SUPPORT
}

// 1:1 문의 상태(2026-10-20) — OPEN = 답 기다림, ANSWERED = 운영자가 답함(문의한 사람이 다시 쓰면 OPEN), CLOSED = 끝남
enum InquiryStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum Role {
  USER
  AGENCY_STAFF
  ADMIN
  ACTOR
}

enum AuthProvider {
  GOOGLE
  APPLE
  NAVER
  KAKAO
  LINE
}

enum MessageSenderType {
  ARTIST
  FAN
}

enum MessageMediaType {
  TEXT
  PHOTO
  AUDIO
  VIDEO
}

// 신고 사유 분류 — 운영자 대기열에서 빠르게 판단하려고(자세한 내용은 reason에 선택 입력)
enum ReportCategory {
  SPAM
  ABUSE
  SEXUAL
  PRIVACY
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum IapPlatform {
  IOS
  ANDROID
}

// 결제 1건이 어디서 왔는지 — SANDBOX는 결제 없는 테스트 구독(ENABLE_SANDBOX_SUBSCRIBE), 정산에선 기본으로 뺌
enum ChargeSource {
  SANDBOX
  APPLE
  GOOGLE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ParentalConsentStatus {
  // 만 14세 이상이라 애초에 동의가 필요 없는 계정 (기본값)
  NOT_REQUIRED
  // 만 14세 미만인데 아직 법정대리인(부모) 동의를 못 받은 상태 — 구독/결제 불가
  PENDING
  // 법정대리인이 이메일 링크로 동의 완료
  APPROVED
  // 성인만 가입(ADULTS_ONLY, 2026-09-29 기본값)일 때 성년 나이 미만 — 온보딩에서 막히고 구독 불가.
  // 생년월일은 한 번만 입력 가능해서 나이를 고쳐 다시 시도할 수 없음(잘못 입력했으면 고객센터 → 운영자 정정)
  UNDERAGE
}

model User {
  // email은 로그인 제공자가 달라도 같은 사람이면 계정을 하나로 합치는 데 씀
  // (예: 구글로 먼저 가입 후 나중에 카카오로 로그인해도 AuthIdentity만 추가되고 User는 그대로)
  id                       String                @id @default(uuid())
  role                     Role                  @default(USER)
  displayName              String
  // 팬끼리·스타에게 보이는 이름(앱 전체 하나, 중복 허용 — 버블 방식). displayName은 소셜 로그인에서 받은
  // 이름이라 실명일 수 있어서 화면·푸시·인용에는 쓰지 않음. 같은 닉네임 구분은 스타·소속사·운영자 화면에서만
  // id 끝 4자리 태그(#A1B2)로. 변경은 7일에 한 번(잠정, STATUS.md 출시 전 확정 정책).
  nickname                 String?
  nicknameChangedAt        DateTime?
  email                    String?               @unique
  // 앱 표시 언어(ko/th/en/ja/zh-Hans/zh-Hant/vi/es/pt-BR) — 푸시 알림처럼 서버가 만드는 문구의 언어를 고르는 데 씀.
  // 앱이 기기 언어/설정 변경 시 PATCH /auth/me/locale로 동기화. null이면 기본 언어(en).
  locale                   String?
  status                   UserStatus            @default(ACTIVE)
  suspendedUntil           DateTime?
  bannedAt                 DateTime?
  // 제재(정지·영구차단) 사유 — 분류는 당사자에게 안내(번역), 메모는 운영자 내부용(2026-09-28)
  sanctionCategory         ReportCategory?
  sanctionNote             String?
  // 생년월일 미입력 상태(null)면 앱이 온보딩에서 먼저 물어봄 — 만 14세 미만 판정에만 씀
  birthDate                DateTime?
  parentalConsentStatus    ParentalConsentStatus @default(NOT_REQUIRED)
  parentEmail              String?
  // AGENCY_STAFF 계정이 속한 소속사 — 같은 소속사 배우 전원을 모니터링할 수 있음
  // (소속사 안에서 직원별로 담당 배우를 나누지 않기로 확정, 2026-09-28)
  agencyId                 String?
  // 가입 시 이용약관·개인정보 수집 동의 기록 — 동의한 약관 버전과 시각. 약관 버전이 바뀌면(CURRENT_TERMS_VERSION)
  // 앱 온보딩에서 다시 동의받음. 역할과 상관없이 모든 계정.
  termsVersion             String?
  termsAcceptedAt          DateTime?
  // 첫 답장 전 "아티스트 명예훼손·사생활 침해·불쾌한 메시지 금지, 위반 시 제재·법적 책임" 안내에 동의한 시각(버블 방식,
  // 2026-10-12). 제재·환불 분쟁 때 근거로 남김 — 한 번 동의하면 다시 묻지 않음. null이면 앱이 첫 답장 전에 물어봄.
  replyRulesAcceptedAt     DateTime?
  // 생일 축하 메시지 받기(2026-10-12) — 켜면 생년월일의 월·일에 구독 중인 방의 생일 축하 메시지가 옴. 생년월일을 연령 확인 외 목적에
  // 쓰는 거라 본인이 켜야 함(기본 꺼짐). 아티스트·소속사에겐 날짜를 보여 주지 않음.
  birthdayGreetingsEnabled Boolean               @default(false)
  // 팬 프로필 사진·상태메시지(2026-10-12 사용자 결정으로 1차) — 사진은 저장소 키(users/<id>/profile/), 상태메시지는 60자.
  // 본인 마이페이지와 아티스트·소속사의 팬 답장 화면에만 보임(다른 팬에겐 안 보임). 운영자가 지울 수 있음(신고 대응).
  profileImageUrl          String?
  statusMessage            String?
  // 역할별 알림 설정(2026-10-12) — 소속사 직원: 소속 아티스트 새 메시지·스토리 푸시 / 아티스트·소속사: 장기 미발송 알림.
  // 팬의 아티스트별 끄기는 Subscription.notificationsMuted, 생일은 위 birthdayGreetingsEnabled
  notifyArtistMessages     Boolean               @default(true)
  notifyIdleAlerts         Boolean               @default(true)
  // 메시지 자동 번역(2026-10-16) — 켜면 앱 언어와 다른 글자로 쓴 말풍선을 누르지 않아도 원문 아래에 번역. 기본 켜짐(번역은 메시지×언어마다
  // 한 번만 해서 저장하므로 팬 수와 무관한 비용). 설정 > 언어에서 끔
  autoTranslate            Boolean               @default(true)
  // 가입할 때 기기의 지역 설정(ISO 국가 코드, 예: TH·KR) — 미성년자 기준 나이를 국가별로 적용하고(minor-age.ts)
  // 통계(국가별 가입자)에 씀. 가입 기기(ios/android/web)도 통계용. 약관 동의 때 앱이 보냄.
  countryCode              String?
  signupPlatform           String?
  // 마지막 접속(한 시간 단위로만 갱신) — 일간·월간 이용자 수 통계용
  lastActiveAt             DateTime?
  // 운영자 권한 단계(2026-10-20) — ADMIN만 의미: OWNER = 전부, SUPPORT = 고객 응대(신고·회원 제재·문의·모니터링·공지)만(정산·소속사
  // 배분율·앱 설정·아티스트 등록/가격·운영자 관리 불가). null이면 OWNER(기존 운영자 그대로)
  adminLevel               AdminLevel?
  // 운영자 2단계 인증(TOTP, 2026-10-20) — 비밀 키(base32)는 켜기 전 확인까지 totpPendingSecret, 확인되면 totpSecret + totpEnabledAt.
  // 켜져 있으면 운영자 API는 코드를 확인한 토큰(mfa)만 받음
  totpSecret               String?
  totpPendingSecret        String?
  totpEnabledAt            DateTime?
  // 회원 탈퇴 시각 — 탈퇴하면 개인정보(이메일·이름·닉네임·생년월일 등)를 지우고 이 값만 남김. 결제·구독 기록은
  // 법정 보관 기간 동안 유지, 팬 답장은 "탈퇴한 팬"으로 표시(잠정, STATUS.md 출시 전 확정 정책).
  deletedAt                DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  authIdentities     AuthIdentity[]
  subscriptions      Subscription[]
  birthdayGreetings  BirthdayGreeting[]
  subscriptionEvents SubscriptionEvent[]
  purchases          Purchase[]
  fanMessages        Message[]           @relation("FanMessages")
  agency             Agency?             @relation(fields: [agencyId], references: [id])
  pushDevices        PushDevice[]
  accessLogs         AccessLog[]
  releaseWatches     ReleaseWatch[]
  blockedInChannels  ActorFanBlock[]     @relation("BlockedInChannels")
  blocksIssued       ActorFanBlock[]     @relation("BlocksIssued")
  reportsFiled       Report[]            @relation("ReportsFiled")
  actorSelf          Actor?              @relation("ActorSelf")
  storyViews         StoryView[]
  parentalConsent    ParentalConsent?
  adminActions       AdminAction[]       @relation("AdminActions")
  supportInquiries   SupportInquiry[]

  // 운영자 회원 검색(이름·닉네임·이메일 중간 글자) — 회원이 가장 많이 늘어나는 테이블이라 글자 조각 색인(pg_trgm, 2026-09-29)
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_displayName_trgm_idx")
  @@index([nickname(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_nickname_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
}

// 푸시 받을 기기 — 한 사람이 폰·태블릿 등 여러 기기로 받을 수 있게 기기(토큰)마다 한 줄(유료 서비스라
// 계정당 1대로 제한하지 않음, 2026-09-28). 토큰은 한 계정에만 속함(같은 폰에서 계정을 바꾸면 옮겨감).
// FCM이 "죽은 토큰"이라고 알려주면 발송 중에 자동 삭제.
model PushDevice {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 접속 기록(2026-10-14) — 운영자 회원 관리에서 "언제·어떤 기기로 들어왔는지" 확인용(소속사 데모 접속 확인, 계정 도용·분쟁 대응).
// LOGIN = 로그인할 때마다 한 줄, VISIT = 로그인이 유지된 채 앱을 쓸 때 한 시간에 한 줄(User.lastActiveAt 갱신과 같은 때).
// 기기 정보는 앱이 요청마다 보내는 X-Client-* 헤더(없으면 빈 값), 웹은 브라우저 정보(userAgent)로 표시.
// 3개월 지나면 매일 지움(access-log.service.ts, 통신비밀보호법 접속 기록 3개월 — 탈퇴해도 그때까지 보관, 잠정 정책).
model AccessLog {
  id          String   @id @default(uuid())
  userId      String
  // LOGIN / VISIT
  kind        String
  // 로그인 수단(LOGIN만) — GOOGLE·APPLE·KAKAO·NAVER·LINE 또는 DEV(데모·개발용 이메일 로그인)
  method      String?
  platform    String?
  deviceModel String?
  osVersion   String?
  appVersion  String?
  userAgent   String?
  ip          String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// 소속사별 데모 입장 코드(2026-10-19) — 운영자가 소속사 이름·코드·만료일을 등록하고, 코드 하나로 웹 데모의 소속사·아티스트·팬
// 버튼을 다 씀(데모 계정은 모든 소속사가 같이 씀 — 코드는 "누가 들어왔는지"만 구분). 데모 초기화(demo-seed)로 지우지 않고, 코드는
// 지우지 않고 중지만(접속 기록이 남아야 해서). User와 연결하지 않음.
model DemoAccessCode {
  id          String    @id @default(uuid())
  agencyName  String
  // 소문자로 저장 — 입력은 대소문자 구분 없이
  code        String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  note        String?
  // 목록용 요약 — 기록을 매번 세지 않게. lastSeenAt은 쓰는 동안 5분에 한 번 갱신
  firstSeenAt DateTime?
  lastSeenAt  DateTime?
  // 30분 넘게 활동이 없다가 새로 들어온 횟수(= 접속 알림 메일 수)
  visitCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events DemoAccessEvent[]
}

// 데모 접속 기록(2026-10-19) — LOGIN은 로그인할 때마다, VISIT는 로그인 유지 중 코드·역할마다 한 시간에 한 줄 + 새로 들어올 때.
// codeId가 null이면 공용 코드(DEV_LOGIN_CODE, 내부 테스트용). 3개월 지나면 매일 지움(접속 기록과 같은 기간).
model DemoAccessEvent {
  id          String   @id @default(uuid())
  codeId      String?
  // agency / artist / fan / other
  role        String
  // LOGIN / VISIT
  kind        String
  // 30분 넘게 비었다가 새로 들어온 접속 — 알림 메일을 보낸 줄
  newVisit    Boolean  @default(false)
  platform    String?
  deviceModel String?
  osVersion   String?
  appVersion  String?
  userAgent   String?
  ip          String?
  createdAt   DateTime @default(now())

  code DemoAccessCode? @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([codeId, createdAt])
  @@index([createdAt])
}

model AuthIdentity {
  id         String       @id @default(uuid())
  provider   AuthProvider
  providerId String
  userId     String
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// 만 14세 미만 회원의 법정대리인(부모) 동의 — 이메일로 보낸 링크를 부모가 클릭하면 확정.
// userId가 unique라 재요청은 새로 만들지 않고 기존 레코드를 갱신(토큰 재발급)함.
model ParentalConsent {
  id          String    @id @default(uuid())
  userId      String    @unique
  token       String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  confirmedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 아티스트 성별(2026-10-02) — 둘러보기의 "여성 아티스트"·"남성 아티스트" 줄. 비어 있으면(그룹·혼성 등) 지정 안 함 — 두 줄엔 안 나오고
// 검색·소속사별·새로 온 줄에만. 커플방은 항상 비움
enum ArtistGender {
  FEMALE
  MALE
}

enum ActorKind {
  // 배우 1명의 개인방
  SOLO
  // 배우 2명의 커플(CP)방 — 멤버는 CoupleMember
  COUPLE
}

model Actor {
  // 공식 프로필(실명+공식 사진)과 대화방 프로필(닉네임+사진)을 분리 — 대화방 쪽은
  // 소속사가 메신저 프로필 바꾸듯 자유롭게 변경 가능 (Bubble/Weverse 벤치마킹).
  // 이모지는 쓰지 않고 이름+이미지만 사용.
  //
  // 2026-09-29부터 Actor 한 줄 = "방" 하나: kind SOLO는 배우 개인방(지금까지와 같음), COUPLE은 배우 2명의 커플방.
  // 메시지·구독·구매·묶음·차단·신고·실시간·통계가 전부 actorId(= 방)로 동작해서 커플방도 같은 코드를 씀.
  // 커플방은 공식 이름·공식 사진·가격은 운영자, 방 이름(chatDisplayName)·대화방 사진은 두 멤버 배우가 각자 바꿀 수 있음.
  // 커플방은 소속사(agencyId)·본인 계정(selfUserId)이 없고 권한은 멤버 배우를 통해 판단(actor-access.ts).
  id                      String        @id @default(uuid())
  kind                    ActorKind     @default(SOLO)
  // 장기 미발송 알림(2026-09-29) — 마지막으로 알린 단계(3일·7일·14일…)와 그때의 기준 시각(마지막 메시지 시각). 새 메시지를 보내면 기준 시각이
  // 바뀌어 처음부터 다시 셈. 같은 단계를 두 번 보내지 않게 기록만 함
  idleReminderStage       Int?
  idleReminderFor         DateTime?
  legalName               String
  officialProfileImageUrl String?
  chatDisplayName         String
  chatProfileImageUrl     String?
  // 토피룸 배경 사진(2026-10-14 사용자 결정, 1차) — 아티스트 본인·소속사가 정함, 팬 토피룸 뒤에 깔림. null이면 기본 배경
  chatBackgroundUrl       String?
  gender                  ArtistGender?
  monthlyPriceCents       Int
  // 개인 구독 스토어 상품 ID(애플·구글 공통, 소문자·숫자·_·.) — 등록 전엔 null(샌드박스 구독만). 2026-09-29
  storeProductId          String?       @unique
  verified                Boolean       @default(false)
  selfUserId              String?       @unique
  // 현재 소속사(무소속이면 null) — 바꿀 때는 반드시 ActorAgencyHistory도 같이 갱신할 것
  // (AdminAgenciesService.assignActor 참고)
  agencyId                String?
  // 활동 종료(계약 종료 등) — 둘러보기·검색에서 숨기고 신규 구독을 막음. 기존 구독 팬은 대화 유지(잠정, STATUS 정책 표)
  retiredAt               DateTime?
  // 구독 직후 대화방 첫 줄에 보이는 환영 메시지(아티스트가 미리 써 둠, {{name}} = 팬 닉네임, 2026-10-12). 메시지 행이 아니라
  // 보여 줄 때 만들어서 미발송 환불·답장 대상·통계엔 안 셈(버블도 웰컴메시지는 환불 판단에서 뺌). null이면 안 보임
  welcomeMessage          String?
  // 생일 축하 메시지(2026-10-12) — 생일 알림을 켠 구독 팬의 생일(태국 날짜) 아침에 그 팬 대화방에만 들어감(BirthdayGreeting)
  birthdayMessage         String?
  // 공개 시각(2026-10-19, 예약 오픈) — null이면 바로 공개. 이 시각 전엔 팬 화면에 "곧 공개" 카드 + "알림 받기"만, 구독 불가.
  // 열리는 건 시각 비교라 정각에 바로, 알림 받기 팬 푸시는 ReleaseService(1분마다)가 releaseNotifiedAt을 먼저 잡고 한 번만 보냄
  releaseAt               DateTime?
  releaseNotifiedAt       DateTime?
  // 활동 종료 예정(2026-10-20 사용자 결정) — 넣는 순간 신규 구독을 막고(팬 화면 "N월 N일 활동 종료 예정"), 그 시각이 되면 RetireScheduler가
  // retiredAt을 채움(그때 기존 종료와 같은 알림·환불 규칙). retiredAt이 있으면 의미 없음. 예정을 지우면 다시 구독 가능
  retireAt                DateTime?
  // 애플 스토어 상품 판매 중지를 운영자가 했다고 표시한 시각(2026-10-20) — 애플은 개발자가 팬 구독을 끊는 API가 없어서 종료(예정) 방의 상품은
  // 운영자가 App Store Connect에서 판매 중지 → 여기 표시. 구글은 서버가 구독마다 자동 해지(store-renewal.service)
  storeSaleStoppedAt      DateTime?
  // 계약 종료일(2026-10-20) — 넣어 두면 31일 전부터 운영자 할 일·알림(애플 판매 중지가 다음 갱신 전에 효력이 있게). 실제 종료는 운영자가 예정을 잡음
  contractEndAt           DateTime?
  contractAlertedAt       DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  selfUser           User?                @relation("ActorSelf", fields: [selfUserId], references: [id])
  agency             Agency?              @relation(fields: [agencyId], references: [id])
  agencyHistory      ActorAgencyHistory[]
  fanBlocks          ActorFanBlock[]
  subscriptions      Subscription[]
  subscriptionEvents SubscriptionEvent[]
  messages           Message[]            @relation("MessageChannel")
  // 커플방이면 멤버 배우 2명 / 1인 배우면 이 배우가 속한 커플방들
  coupleMembers      CoupleMember[]       @relation("CoupleRoom")
  memberOfCouples    CoupleMember[]       @relation("CoupleMemberActor")
  sentMessages       Message[]            @relation("MessageSenderActor")
  stories            Story[]
  purchases          Purchase[]
  bundles            BundleActor[]
  allocationsAsRoom  ChargeAllocation[]   @relation("AllocationRoom")
  allocationsAsActor ChargeAllocation[]   @relation("AllocationActor")
  birthdayGreetings  BirthdayGreeting[]
  dailyStats         ActorDailyStat[]
  releaseWatches     ReleaseWatch[]
  linkTokens         ActorLinkToken[]

  @@index([agencyId])
}

// 소속사(방송사가 매니지먼트를 겸하는 경우 포함) — 팬에게도 공개되는 정보
// (소속사별 배우 목록/검색). 계약·정산 조건 필드는 정산 기능 작업 때 추가.
model Agency {
  id        String   @id @default(uuid())
  name      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 정산 배분율(스토어 수수료 뺀 금액 중 소속사 몫, %) — null이면 기본값(AGENCY_REVENUE_SHARE_PERCENT, 잠정 70). 계약마다 다를 수 있음
  revenueSharePercent Int?

  actors       Actor[]
  staff        User[]
  actorHistory ActorAgencyHistory[]
  allocations  ChargeAllocation[]
}

// 배우의 소속사 이력 — 이적 시점 기준으로 정산을 나누거나 계약 분쟁에 대응하기 위한
// 기록용. 모니터링 권한은 이 테이블이 아니라 현재 소속사(Actor.agencyId)로만 판단함
// (이전 소속사는 이적 후 과거 메시지를 볼 수 없음). endedAt이 null인 행이 현재 소속.
model ActorAgencyHistory {
  id        String    @id @default(uuid())
  actorId   String
  agencyId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  actor  Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([actorId])
  @@index([agencyId])
}

// 팬에게 노출되는 탐색/발견 화면 없음 — 동시구독 할인 계산에만 쓰는 내부 페어링

// 방(배우 개인방) 이용권 — 사람×배우당 한 줄. "이 팬이 이 채팅방을 볼 수 있는지"와 채팅방별 상태(대화가 보이기 시작한
// 시점 startedAt, 읽음, 알림 끄기)를 가짐. 열림/닫힘(cancelledAt)은 직접 정하지 않고 **유효한 구매(Purchase)가 하나라도
// 이 배우를 포함하면 열림**으로 서버가 다시 계산함(SubscriptionsService.syncAccess, 2026-09-29 묶음 구독 도입).
// 결제 정보(스토어 영수증)는 Purchase로 옮김.
model Subscription {
  // lastArtistMessageAt / lastFanReplyAt는 30일 무사용 환불 판정에 그대로 사용
  id                  String    @id @default(uuid())
  userId              String
  actorId             String
  startedAt           DateTime  @default(now())
  lastArtistMessageAt DateTime?
  lastFanReplyAt      DateTime?
  cancelledAt         DateTime?
  // 이 배우의 새 메시지 알림 끄기(카톡 채팅방 알림 끄기처럼) — 구독·메시지 수신은 그대로
  notificationsMuted  Boolean   @default(false)
  // 팬이 이 채팅방을 마지막으로 본 시각 — 인박스의 안 읽은 개수(이 시각 이후의 스타 메시지). 채팅방 조회 때 갱신
  lastReadAt          DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([userId, actorId])
}

// 구매(결제 단위) — 배우 개인 구독 1건(actorId) 또는 묶음 1건(bundleId), 둘 중 하나만. 방 이용권(Subscription)은
// 유효한 구매들로부터 계산됨. 실제 결제(IAP) 연동 전(샌드박스)엔 iap* 전부 null이고 startedAt/cancelledAt만으로 판단.
model Purchase {
  id               String       @id @default(uuid())
  userId           String
  actorId          String?
  bundleId         String?
  // 구매 시점 월 가격(표시 가격 기준, 실제 청구는 스토어 상품 가격)
  priceCents       Int?
  startedAt        DateTime     @default(now())
  cancelledAt      DateTime?
  iapPlatform      IapPlatform?
  // Apple의 originalTransactionId 또는 Google의 purchaseToken — 스토어 쪽 구독 인스턴스 식별자
  iapTransactionId String?      @unique
  iapExpiresAt     DateTime?
  // 스토어 자동 갱신이 켜져 있나(2026-10-02) — 팬이 스토어에서 해지(자동 갱신 끔)하면 false, 기간(iapExpiresAt) 끝까지는 이용.
  // 앱 대화 목록·구독 관리의 "○월 ○일까지 이용" 표시용. 스토어 알림·영수증이 알려 줄 때만 바뀜(모르면 그대로)
  willRenew        Boolean      @default(true)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor  Actor?  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  bundle Bundle? @relation(fields: [bundleId], references: [id], onDelete: Restrict)

  charges PurchaseCharge[]

  @@index([userId, cancelledAt])
  @@index([bundleId])
  @@index([actorId])
}

// 묶음 상품 — 여러 배우 개인방을 할인가로 한 번에(2026-09-29 사용자 결정). 스토어엔 상품 하나로 등록하고, 사면 포함된
// 방 이용권을 모두 열어 줌. 커플(CP)방이 생기면 여기에 커플방도 넣을 수 있게 할 예정(2차).
model Bundle {
  id                 String    @id @default(uuid())
  name               String
  priceCents         Int
  // 스토어에 등록한 구독 상품 ID(애플·구글 공통, 소문자·숫자·_·.) — 등록 전엔 null(샌드박스 구독만)
  storeProductId     String?   @unique
  // 판매 중지(false)면 새로 살 수 없음 — 이미 산 팬은 유지
  active             Boolean   @default(true)
  // 공개 시각(2026-10-19) — Actor.releaseAt과 같은 규칙. 묶음 안 아티스트가 아직 공개 전이면 그 시각까지도 못 삼
  releaseAt          DateTime?
  releaseNotifiedAt  DateTime?
  // 애플 스토어 판매 중지 표시(2026-10-20, Actor.storeSaleStoppedAt과 같음) — 든 방이 종료(예정)일 때
  storeSaleStoppedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  actors         BundleActor[]
  purchases      Purchase[]
  releaseWatches ReleaseWatch[]
}

// "곧 공개" 알림 받기(2026-10-19) — 팬 × (아티스트 방 또는 묶음) 한 줄. 공개되면 푸시를 보내고 줄은 남겨 둠(사전 수요 숫자 기록)
model ReleaseWatch {
  id        String   @id @default(uuid())
  userId    String
  actorId   String?
  bundleId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor  Actor?  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  bundle Bundle? @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([userId, actorId])
  @@unique([userId, bundleId])
  @@index([actorId])
  @@index([bundleId])
}

// 아티스트 계정 연결 링크(2026-10-19) — 아이디·비밀번호를 만들어 주지 않고, 운영자가 만든 1회용 링크를 아티스트가 열어 본인 소셜
// 계정을 붙임. 원문 토큰은 링크에만 있고 여기엔 sha256 해시만. 한 번 쓰면(usedAt) 끝, 다시 만들면 예전 것은 revokedAt
model ActorLinkToken {
  id           String    @id @default(uuid())
  actorId      String
  tokenHash    String    @unique
  createdById  String
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
}

model BundleActor {
  bundleId String
  actorId  String

  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  actor  Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@id([bundleId, actorId])
  @@index([actorId])
}

enum SubscriptionEventType {
  STARTED
  CANCELLED
}

// 구독 시작·해지 이력 — Subscription은 사람×배우당 한 줄이라 재구독하면 startedAt/cancelledAt이 덮어써짐.
// 구독률·해지율·재구독률·매출 추이 같은 통계(운영자 대시보드, 2차)를 위해 일어난 일을 그대로 쌓아둠.
// priceCents는 시작 시점에 실제 적용된 월 가격(동시구독 할인 반영).
model SubscriptionEvent {
  id         String                @id @default(uuid())
  userId     String
  actorId    String
  type       SubscriptionEventType
  priceCents Int?
  createdAt  DateTime              @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Message {
  // 아티스트 메시지는 구독자 전체에게 방송되는 한 건이라(fanUserId가 없음), 팬 이름
  // 하나를 필드로 못 박아둘 수 없음 — 대신 body에 "{{name}}" 플레이스홀더를 넣어두면
  // 조회 시점에 요청한 팬 본인의 displayName으로 치환해서 내려줌(Bubble 개인화 메시지 방식)
  id               String            @id @default(uuid())
  actorId          String
  senderActorId    String?
  senderType       MessageSenderType
  fanUserId        String?
  mediaType        MessageMediaType  @default(TEXT)
  body             String?
  // 미디어 위치: 우리 스토리지(R2 등)에 올린 파일이면 mediaKey(객체 키), 외부 주소(시드 데이터 등)면
  // mediaUrl. 응답에서는 mediaKey를 그때그때 서명된 임시 URL로 바꿔 mediaUrl로 내려줌(MediaService).
  mediaUrl         String?
  mediaKey         String?
  // 영상 썸네일(첫 장면 사진) — 스타 앱이 영상을 보낼 때 같이 올림(purpose message의 PHOTO). 없으면 앱이 어두운 타일로
  thumbnailKey     String?
  // 사진·영상을 불러오는 동안 보여줄 흐린 미리보기(ThumbHash, 앱이 올릴 때 계산해서 보냄, 2026-09-29) — 없으면 빈 배경
  thumbhash        String?
  // 음성·영상 길이(말풍선 표시용)와 음성 음파(카톡처럼) — 음파는 녹음할 때 앱이 측정한 음량을 0~1로
  // 줄여 보냄(최대 64칸). 없으면 앱이 메시지 id로 만든 모양을 대신 그림.
  mediaDurationMs  Int?
  waveform         Json?
  // 어떤 메시지에 대한 답장인지 — 팬 답장은 서버가 "보낸 시점의 가장 최근 스타 메시지"로 자동 지정
  // (버블 방식, 2026-09-28 확정). 스타의 인용 답장(예정)은 인용한 팬 메시지를 가리킴.
  // 원본이 지워지면 null(앱에서 "삭제된 메시지"로 표시).
  replyToMessageId String?
  // 스타 메시지 삭제(보내기 취소)·운영자 가림 — 지우지 않고 표시만(소속사 모니터링 기록·신고 증거용). 둘 다 팬
  // 화면에선 사라짐. deletedByAdmin이면 운영자가 신고 승인으로 가린 것(스타 화면엔 "운영 정책으로 가려진 메시지").
  deletedAt        DateTime?
  deletedByAdmin   Boolean           @default(false)
  // 소속사가 대신 지운 메시지(2026-10-12, 사고 대응) — 지운 직원 id. 팬 화면에선 아티스트가 지운 것과 똑같이 흔적 없이 사라지고,
  // 아티스트·소속사 화면엔 "소속사가 삭제한 메시지"로 남음
  deletedByStaffId String?
  createdAt        DateTime          @default(now())

  actor         Actor                @relation("MessageChannel", fields: [actorId], references: [id], onDelete: Cascade)
  // 스타 메시지를 실제로 보낸 배우 — 1인 방은 그 배우, 커플방은 두 멤버 중 보낸 쪽(말풍선에 이름·사진 표시). 팬 답장은 null
  senderActor   Actor?               @relation("MessageSenderActor", fields: [senderActorId], references: [id], onDelete: SetNull)
  fanUser       User?                @relation("FanMessages", fields: [fanUserId], references: [id])
  replyTo       Message?             @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies       Message[]            @relation("MessageReplies")
  translations  MessageTranslation[]
  reports       Report[]
  blockTriggers ActorFanBlock[]

  @@index([replyToMessageId])
  // 팬 대화방 나눠 받기·방 안 검색·사진 모아보기가 전부 "이 방의 메시지를 시간순으로" 찾음(2026-09-29)
  @@index([actorId, createdAt])
  // 방 안 검색(본문 중간 글자) — 팬 답장까지 한 테이블이라 인기 배우 방은 행이 많아서 글자 조각 색인(pg_trgm, 2026-09-29)
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "Message_body_trgm_idx")
}

// 원문은 한 번만 저장, 언어별 번역본은 필요할 때 생성해서 여기 캐싱 (lazy translation)
model MessageTranslation {
  id             String   @id @default(uuid())
  messageId      String
  languageCode   String
  translatedText String
  createdAt      DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, languageCode])
}

// 인스타그램 스토리처럼 24시간 뒤 사라지는 콘텐츠 — 배우 본인만 업로드, 구독자만 열람
// 가능. mediaType은 TEXT를 쓰지 않음(DTO에서 검증) — Message와 enum을 공유하는 이유는
// 미디어 종류가 같기 때문일 뿐, 스토리는 항상 미디어가 있어야 함.
model Story {
  id        String           @id @default(uuid())
  actorId   String
  mediaType MessageMediaType
  // Message와 같은 규칙 — 둘 중 하나는 반드시 있음(업로드 API로 만든 스토리는 mediaKey)
  mediaUrl  String?
  mediaKey  String?
  createdAt DateTime         @default(now())
  expiresAt DateTime

  actor Actor       @relation(fields: [actorId], references: [id], onDelete: Cascade)
  views StoryView[]
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  fanUserId String
  viewedAt  DateTime @default(now())

  story   Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  fanUser User  @relation(fields: [fanUserId], references: [id], onDelete: Cascade)

  @@unique([storyId, fanUserId])
}

model Report {
  id           String         @id @default(uuid())
  messageId    String
  reportedById String
  category     ReportCategory @default(OTHER)
  reason       String?
  status       ReportStatus   @default(PENDING)
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reportedBy User    @relation("ReportsFiled", fields: [reportedById], references: [id])

  // 같은 사람이 같은 메시지를 여러 번 신고해서 순위를 올리는 걸 막음
  @@unique([messageId, reportedById])
}

// 팬 답장 전송 전에 대조하는 금칙어 목록 — 한국어/태국어/영어 3개 언어로 관리
model BannedWord {
  id        String   @id @default(uuid())
  term      String
  // 앱 언어 9개 중 하나 — 띄어쓰기 언어(en/es/pt-BR/vi)는 단어 단위로, 나머지는 포함되면 막음(matchesBannedWord). 막는 건 언어와 상관없이 모두에게
  language  String
  // 운영자 화면 [기본 목록 넣기]로 들어온 단어(2026-10-20, default-banned-words.ts) — 화면에 "기본" 표시
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([term, language])
}

// 배우 채널 단위 차단 — 배우 본인·소속사가 운영자 없이 바로 걸 수 있음(잠정 정책, STATUS.md). 차단된 팬은 그
// 배우에게 답장을 못 보내고, 이미 보낸 답장도 스타·소속사 화면에서 빠짐. 구독·메시지 열람은 그대로 유지(환불
// 문제 없음). 서비스 전체 제재(정지·차단)는 운영자만(User.status).
model ActorFanBlock {
  id          String   @id @default(uuid())
  actorId     String
  fanUserId   String
  blockedById String
  reason      String?
  // 차단 계기가 된 팬 답장(2026-10-13, 소속사 "기록" 화면) — 차단하면 그 답장이 다른 화면에서 빠져서 여기서만 다시 볼 수 있음
  messageId   String?
  createdAt   DateTime @default(now())

  actor     Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  fanUser   User     @relation("BlockedInChannels", fields: [fanUserId], references: [id], onDelete: Cascade)
  blockedBy User     @relation("BlocksIssued", fields: [blockedById], references: [id])
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([actorId, fanUserId])
  @@index([fanUserId])
}

// 운영자 작업 기록 — 누가 언제 누구를 정지·차단·해제했는지, 역할을 바꿨는지, 신고를 처리했는지, 배우 활동을 종료했는지.
// 유료 서비스라 분쟁·문의 대응용 증빙(2026-09-28 점검). 지우지 않음.
model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  // USER_SUSPEND / USER_BAN / USER_REACTIVATE / USER_ROLE / REPORT_RESOLVE / REPORT_DISMISS / ACTOR_RETIRE / ACTOR_RESTORE /
  // ACTOR_PRICE / BUNDLE_CREATE / BUNDLE_UPDATE (audit.service.ts AdminActionType)
  action     String
  targetType String
  targetId   String
  detail     Json?
  createdAt  DateTime @default(now())

  admin User @relation("AdminActions", fields: [adminId], references: [id])

  @@index([createdAt])
  @@index([targetType, targetId])
}

// 커플방 멤버 — 커플방(Actor kind COUPLE) 하나에 1인 배우 2명(2026-09-29)
model CoupleMember {
  coupleId String
  memberId String

  couple Actor @relation("CoupleRoom", fields: [coupleId], references: [id], onDelete: Cascade)
  member Actor @relation("CoupleMemberActor", fields: [memberId], references: [id], onDelete: Restrict)

  @@id([coupleId, memberId])
  @@index([memberId])
}

/**
 * 결제 1건(첫 결제·매달 갱신) — 정산의 기준(2026-09-29). 구매(Purchase)는 "지금 무엇을 샀나"라 갱신 때 덮어써지지만, 결제 기록은
 * 건별로 쌓이고 지우지 않음(팬이 탈퇴해 구매가 지워져도 purchaseId만 비고 남음 — 세무·정산 근거). 금액·상품은 그 순간 값을 복사해 둠.
 */
model PurchaseCharge {
  id                 String       @id @default(uuid())
  purchaseId         String?
  // 무엇을 샀나(그 순간 복사) — 배우 개인(=방) 또는 묶음
  actorId            String?
  bundleId           String?
  productName        String
  amountCents        Int
  currency           String       @default("THB")
  chargedAt          DateTime
  // 이 결제로 이용할 수 있는 끝(보통 한 달 뒤)
  periodEnd          DateTime
  source             ChargeSource
  // 스토어 쪽 결제 건 식별자(애플 transactionId — 갱신마다 새로 생김, 구글 orderId) — 같은 알림이 두 번 와도 한 번만
  storeTransactionId String?      @unique
  // 스토어가 실제로 청구한 금액(1/1000 단위 — 애플 price 그대로, 구글 micros ÷ 1000)과 통화 — 나라별 가격이라 정산 기준(amountCents, 바트
  // 정가)과 다를 수 있음. 스토어 정산 보고서와 대조용
  storeAmountMilli   Int?
  storeCurrency      String?
  refundedAt         DateTime?
  createdAt          DateTime     @default(now())

  purchase       Purchase?          @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  allocations    ChargeAllocation[]
  refundRequests RefundRequest[]

  // 같은 구매의 같은 시각 결제는 한 번만(샌드박스 갱신·빈 기록 채우기가 여러 서버에서 동시에 돌아도 안전)
  @@unique([purchaseId, chargedAt])
  @@index([chargedAt])
}

/**
 * 결제 1건을 배우별로 나눈 몫 — 결제 순간 기준으로 계산해 고정(나중에 소속사를 옮기거나 정가가 바뀌어도 과거 정산은 그대로).
 * 개인방: 그 배우 100%. 커플방: 두 배우 반씩. 묶음: 포함된 방의 개인 정가 비율로 나눈 뒤 커플방이면 다시 반씩.
 */
model ChargeAllocation {
  id          String  @id @default(uuid())
  chargeId    String
  // 돈이 나온 방(개인방이면 그 배우, 커플방이면 커플방)
  roomId      String
  // 몫을 받는 배우(개인 배우만)
  actorId     String
  // 결제 순간의 소속사(없으면 무소속 — 배우 본인에게 정산)
  agencyId    String?
  amountCents Int

  charge PurchaseCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  room   Actor          @relation("AllocationRoom", fields: [roomId], references: [id], onDelete: Restrict)
  actor  Actor          @relation("AllocationActor", fields: [actorId], references: [id], onDelete: Restrict)
  agency Agency?        @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([chargeId])
  @@index([agencyId])
  @@index([actorId])
}

/**
 * 정산 마감(2026-09-29) — 운영자가 한 달을 마감하면 그 순간의 정산표를 통째로 저장해 고정(소속사에 지급한 근거). 마감 뒤에 생긴
 * 환불·늦게 기록된 결제는 이 달 숫자를 바꾸지 않고, 그 일이 생긴(열려 있는) 달의 "조정" 칸으로 들어감. 마감은 앞 달부터 순서대로.
 */
model SettlementClose {
  // YYYY-MM(태국 시간 기준 한 달)
  month      String   @id
  closedAt   DateTime @default(now())
  // 마감한 운영자(계정이 지워져도 기록은 남게 관계 없이 id만)
  closedById String?
  // 마감 순간의 정산표(SettlementsService.report 결과 전체)
  snapshot   Json

  payouts SettlementPayout[]
}

// 정산 지급 기록(2026-09-29) — 마감한 달의 지급액을 받는 쪽(소속사, 또는 무소속 배우 본인)에게 언제·얼마·어떤 이체로 보냈는지.
// 실제 송금은 은행에서 하고 여기엔 기록만. 받는 쪽 하나당 한 달에 한 번(잘못 적었으면 지우고 다시). 지급 기록이 있는 달은 마감 취소 불가
model SettlementPayout {
  id           String          @id @default(uuid())
  month        String
  close        SettlementClose @relation(fields: [month], references: [month], onDelete: Restrict)
  // 받는 쪽 — 둘 중 하나만(소속사/배우가 지워져도 기록은 남게 관계 없이 id만, 이름은 name에 그때 이름으로)
  agencyId     String?
  actorId      String?
  // "agency:<id>" | "actor:<id>" — 한 달에 받는 쪽 하나당 한 번(null끼리는 unique가 안 걸려서 따로 둠)
  payeeKey     String
  name         String
  // 실제 보낸 금액(은행 수수료 등으로 표의 지급액과 다를 수 있어서 따로 적음)
  amountCents  Int
  paidAt       DateTime
  // 이체 번호·은행 참조 등
  reference    String?
  memo         String?
  recordedById String?
  createdAt    DateTime        @default(now())

  @@unique([month, payeeKey])
}

enum RefundRequestStatus {
  // 우리가 환불까지 끝냄(구글 API·테스트 결제)
  REFUNDED
  // 애플 결제 — 우리가 직접 환불할 수 없어서 애플 환불 요청 페이지로 안내함(애플이 환불하면 스토어 알림으로 결제 기록이 환불로 바뀜)
  STORE_GUIDED
}

// 팬의 환불 요청(2026-09-29) — 지금은 "스타 미발송 환불"(결제 기간 동안 스타 메시지 0개면 기간 끝난 뒤 7일 안에 요청)만.
// 결제 한 건당 한 번(애플 안내는 다시 눌러도 같은 행). 누가 언제 요청했는지 문의·분쟁 대응용 기록
model RefundRequest {
  id        String              @id @default(uuid())
  chargeId  String
  // 팬(탈퇴해도 기록은 남게 관계 없이 id만)
  userId    String
  // 지금은 STAR_IDLE만
  reason    String
  source    ChargeSource
  status    RefundRequestStatus
  createdAt DateTime            @default(now())

  charge PurchaseCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@unique([chargeId, reason])
  @@index([userId])
}

// 팬에게 보낸 생일 축하 메시지 한 건(2026-10-12) — 매일 아침 작업이 그날 생일인 팬 × 구독 중인 방마다 하나 만듦(그때의 문구를
// 이름까지 채워 저장, 해마다 한 번). 그 팬 대화방에만 보이고 아티스트 메시지(Message)가 아니라 환불·답장 대상·통계엔 안 셈.
model BirthdayGreeting {
  id        String   @id @default(uuid())
  userId    String
  actorId   String
  year      Int
  body      String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([userId, actorId, year])
}

// 공지사항(2026-10-12) — 운영자가 쓰고 팬·아티스트 모두 마이페이지 "공지사항"에서 봄(점검·약관 변경·아티스트 종료 등).
// 언어별로 따로 쓰지 않음 — 필요하면 본문에 여러 언어를 같이 적음. 고정한 공지가 맨 위.
model Notice {
  id          String    @id @default(uuid())
  title       String
  body        String
  pinned      Boolean   @default(false)
  // 공지 푸시를 보낸 시각(2026-10-20) — 한 공지에 한 번만
  pushedAt    DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  translations NoticeTranslation[]

  @@index([pinned, createdAt])
}

// 공지 번역(2026-10-20 사용자 결정: 한국어로 쓰고, 다른 언어 팬은 [번역 보기]) — 처음 누른 사람 때 기계 번역해서 저장, 이후 재사용.
// 공지를 고치면(updatedAt이 sourceUpdatedAt보다 늦으면) 다시 번역
model NoticeTranslation {
  noticeId        String
  language        String
  title           String
  body            String
  sourceUpdatedAt DateTime
  createdAt       DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@id([noticeId, language])
}

// 방별 하루 기록(2026-10-13 사용자 결정, 소속사 통계 기간 선택) — 그날(태국 날짜) 끝 무렵의 구독 수·구독 팬 나라·언어. 매시간 오늘 줄을
// 덮어써서 마지막 기록이 그날 마감 상태. 지난 기간을 고르면 "구독 중"·팬 분포를 이 기록으로 보여 줌(기록 시작 전 날짜는 없음).
// 나라·언어는 묶기 전 원래 수({"TH": 12, "unknown": 1}) — 작은 묶음을 "기타"로 합치는 건 보여 줄 때.
model ActorDailyStat {
  id          String   @id @default(uuid())
  actorId     String
  day         String
  subscribers Int
  countries   Json
  languages   Json
  updatedAt   DateTime @updatedAt

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, day])
  @@index([day])
}

// 앱 설정(2026-10-20) — 한 줄(id "app"). 점검 모드(켜면 운영자 말고는 앱이 점검 화면, 서버도 막음)·앱 최소 버전(그보다 낮으면 업데이트 화면)
model AppSetting {
  id                 String    @id @default("app")
  maintenanceOn      Boolean   @default(false)
  // 점검 안내(운영자가 한국어로 — 앱은 번역된 기본 문구 + 이 글)
  maintenanceMessage String?
  maintenanceUntil   DateTime?
  // "1.2.0"처럼 — 비우면 검사 안 함
  minVersionIos      String?
  minVersionAndroid  String?
  updatedById        String?
  updatedAt          DateTime  @updatedAt
}

// 앱 안 1:1 문의(2026-10-20) — 팬·아티스트·소속사가 쓰고 운영자가 답함. 답하면 문의한 사람에게 푸시
model SupportInquiry {
  id        String        @id @default(uuid())
  userId    String
  // ACCOUNT·PAYMENT·REFUND·ARTIST·BUG·OTHER
  category  String
  title     String
  status    InquiryStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([status, updatedAt])
  @@index([userId, updatedAt])
}

model SupportMessage {
  id        String   @id @default(uuid())
  inquiryId String
  // 쓴 사람 — 운영자면 fromAdmin(이름은 "토피 운영팀"으로만 보임)
  authorId  String
  fromAdmin Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  inquiry SupportInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
}
